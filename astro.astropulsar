{
  "$schema": "astropulsar/v1",
  "type": "extension",
  "name": "mi-extension",
  "displayName": "Mi Extension",
  "version": "1.0.0",
  "author": "Tu Nombre",
  "description": "Descripcion de la extension",
  "license": "MIT",
  "icon": "./icon.png",

  "contributes": {
    "themes": [
      {
        "id": "mi-tema",
        "name": "Mi Tema Custom",
        "type": "dark",
        "path": "./themes/mi-tema.json"
      }
    ],
    "snippets": [
      {
        "language": "javascript",
        "path": "./snippets/javascript.json"
      }
    ],
    "commands": [
      {
        "id": "mi-extension.saludar",
        "title": "Saludar",
        "shortcut": "Ctrl+Shift+H"
      }
    ],
    "languages": [
      {
        "id": "mi-lenguaje",
        "extensions": [".miext"],
        "aliases": ["Mi Lenguaje"],
        "configuration": "./languages/mi-lenguaje.json"
      }
    ]
  },

  "settings": {
    "mi-extension.enabled": {
      "type": "boolean",
      "default": true,
      "description": "Activar/desactivar la extension"
    }
  },

  "activationEvents": ["onLanguage:javascript", "onCommand:mi-extension.saludar"]
}
